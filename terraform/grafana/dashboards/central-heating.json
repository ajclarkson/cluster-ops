    {
      "id": 16,
      "title": "Foreign Office — temp vs setpoint",
      "description": "Plug-heater generic_thermostat, not a TRV — no heat_required signal, so it's excluded from the demand timeline above.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "datasource": { "type": "influxdb", "uid": "ff0wxi3sjn2m8a" },
      "targets": [
        { "refId": "A", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"current_temperature\" AS \"Actual\" FROM \"climate.foreign_office\" WHERE $timeFilter" },
        { "refId": "B", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"temperature\" AS \"Setpoint\" FROM \"climate.foreign_office\" WHERE $timeFilter" }
