    },
    {
      "id": 16,
      "title": "Foreign Office — temp vs setpoint",
      "description": "Plug-heater generic_thermostat, not a TRV — no heat_required signal, so it's excluded from the demand timeline above.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "datasource": { "type": "influxdb", "uid": "ff0wxi3sjn2m8a" },
      "targets": [
        { "refId": "A", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"current_temperature\" AS \"Actual\" FROM \"climate.foreign_office\" WHERE $timeFilter" },
        { "refId": "B", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"temperature\" AS \"Setpoint\" FROM \"climate.foreign_office\" WHERE $timeFilter" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": { "lineWidth": 2, "fillOpacity": 5 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Setpoint" }, "properties": [{ "id": "custom.lineStyle", "value": { "dash": [10, 6], "fill": "dash" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      }
    },
    {
      "id": 20,
      "title": "Active heating mode by room",
      "description": "House mode (away/sleep/vacation/normal) alongside each room's active heating preset (comfort / baseline_day / baseline_night / minimum / off) over time",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 44 },
      "datasource": { "type": "influxdb", "uid": "ff0wxi3sjn2m8a" },
      "targets": [
        { "refId": "A", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"state\" AS \"House Mode\" FROM \"sensor.house_active_mode\" WHERE $timeFilter" },
        { "refId": "B", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"state\" AS \"Parlour\" FROM \"sensor.parlour_active_heating\" WHERE $timeFilter" },
        { "refId": "C", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"state\" AS \"Kitchen\" FROM \"sensor.kitchen_active_heating\" WHERE $timeFilter" },
        { "refId": "D", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"state\" AS \"Hallway\" FROM \"sensor.hallway_downstairs_active_heating\" WHERE $timeFilter" },
        { "refId": "E", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"state\" AS \"Bedroom\" FROM \"sensor.bedroom_active_heating\" WHERE $timeFilter" },
        { "refId": "F", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"state\" AS \"Bathroom\" FROM \"sensor.bathroom_active_heating\" WHERE $timeFilter" },
        { "refId": "G", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"state\" AS \"Home Office\" FROM \"sensor.home_office_active_heating\" WHERE $timeFilter" },
        { "refId": "H", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"state\" AS \"Foreign Office\" FROM \"sensor.foreign_office_active_heating\" WHERE $timeFilter" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "comfort":        { "text": "Comfort",        "color": "orange" },
                "baseline_day":   { "text": "Baseline day",   "color": "light-blue" },
                "baseline_night": { "text": "Baseline night", "color": "dark-blue" },
                "minimum":        { "text": "Minimum",        "color": "purple" },
                "off":            { "text": "Off",             "color": "dark-grey" },
                "normal":         { "text": "Normal",         "color": "green" },
                "sleep":          { "text": "Sleep",          "color": "blue" },
                "away":           { "text": "Away",           "color": "red" },
                "vacation":       { "text": "Vacation",       "color": "dark-red" }
              }
            }
          ]
        }
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 40,
      "title": "Heating source by room",
      "description": "Why each room is at its current setpoint: schedule (normal timetable), manual (user override via the manual-mode helper), house_mode (sleep/away/vacation forcing), or safety (window open, or heating disabled). A room showing manual far more than schedule means its timetable doesn't match how you actually want it heated — tune the schedule, not the override.",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 52 },
      "datasource": { "type": "influxdb", "uid": "ff0wxi3sjn2m8a" },
      "targets": [
        { "refId": "A", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"state\" AS \"Parlour\" FROM \"sensor.parlour_heating_source\" WHERE $timeFilter" },
        { "refId": "B", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"state\" AS \"Kitchen\" FROM \"sensor.kitchen_heating_source\" WHERE $timeFilter" },
        { "refId": "C", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"state\" AS \"Hallway\" FROM \"sensor.hallway_downstairs_heating_source\" WHERE $timeFilter" },
        { "refId": "D", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"state\" AS \"Bedroom\" FROM \"sensor.bedroom_heating_source\" WHERE $timeFilter" },
        { "refId": "E", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"state\" AS \"Bathroom\" FROM \"sensor.bathroom_heating_source\" WHERE $timeFilter" },
        { "refId": "F", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"state\" AS \"Home Office\" FROM \"sensor.home_office_heating_source\" WHERE $timeFilter" },
        { "refId": "G", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"state\" AS \"Foreign Office\" FROM \"sensor.foreign_office_heating_source\" WHERE $timeFilter" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "schedule":   { "text": "Schedule",   "color": "green" },
                "manual":     { "text": "Manual",     "color": "orange" },
                "house_mode": { "text": "House mode", "color": "blue" },
                "safety":     { "text": "Safety",     "color": "red" },
                "none":       { "text": "None",       "color": "dark-grey" }
              }
            }
          ]
        }
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 41,
      "title": "TRV load estimate by room",
      "description": "Each TRV's own adaptive estimate of how much heat its radiator can deliver. A room whose estimate drifts down over weeks relative to the others points at a specific radiator problem (airlock, valve not opening fully, undersized for the room) rather than a scheduling issue.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 60 },
      "datasource": { "type": "influxdb", "uid": "ff0wxi3sjn2m8a" },
      "targets": [
        { "refId": "A", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"value\" AS \"Parlour\" FROM \"sensor.parlour_trv_load_estimate\" WHERE $timeFilter" },
        { "refId": "B", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"value\" AS \"Kitchen\" FROM \"sensor.kitchen_trv_load_estimate\" WHERE $timeFilter" },
        { "refId": "C", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"value\" AS \"Hallway\" FROM \"sensor.hallway_downstairs_trv_load_estimate\" WHERE $timeFilter" },
        { "refId": "D", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"value\" AS \"Bedroom\" FROM \"sensor.bedroom_trv_load_estimate\" WHERE $timeFilter" },
        { "refId": "E", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"value\" AS \"Bathroom\" FROM \"sensor.bathroom_trv_load_estimate\" WHERE $timeFilter" },
        { "refId": "F", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"value\" AS \"Home Office\" FROM \"sensor.home_office_trv_load_estimate\" WHERE $timeFilter" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "lineWidth": 2, "fillOpacity": 0 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      }
    },
    {
      "id": 42,
      "title": "TRV preheat time by room",
      "description": "Each TRV's own estimate of how long it needs to preheat the room to reach setpoint. A rising trend for one room relative to the others is an early signal of reduced radiator output, before it shows up as a visible temperature shortfall.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 60 },
      "datasource": { "type": "influxdb", "uid": "ff0wxi3sjn2m8a" },
      "targets": [
        { "refId": "A", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"value\" AS \"Parlour\" FROM \"sensor.parlour_trv_preheat_time\" WHERE $timeFilter" },
        { "refId": "B", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"value\" AS \"Kitchen\" FROM \"sensor.kitchen_trv_preheat_time\" WHERE $timeFilter" },
        { "refId": "C", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"value\" AS \"Hallway\" FROM \"sensor.hallway_downstairs_trv_preheat_time\" WHERE $timeFilter" },
        { "refId": "D", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"value\" AS \"Bedroom\" FROM \"sensor.bedroom_trv_preheat_time\" WHERE $timeFilter" },
