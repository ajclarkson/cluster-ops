        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      }
    },
    {
      "id": 15,
      "title": "Home Office — temp vs setpoint",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "influxdb", "uid": "ff0wxi3sjn2m8a" },
      "targets": [
        { "refId": "A", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"current_temperature\" AS \"Actual\" FROM \"climate.home_office_trv\" WHERE $timeFilter" },
        { "refId": "B", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"temperature\" AS \"Setpoint\" FROM \"climate.home_office_trv\" WHERE $timeFilter" }
      ],
