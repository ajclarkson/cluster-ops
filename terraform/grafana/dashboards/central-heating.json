      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "influxdb", "uid": "ff0wxi3sjn2m8a" },
      "targets": [
        { "refId": "A", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"current_temperature\" AS \"Actual\" FROM \"climate.bathroom_trv\" WHERE $timeFilter" },
        { "refId": "B", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"temperature\" AS \"Setpoint\" FROM \"climate.bathroom_trv\" WHERE $timeFilter" }
      ],
      "fieldConfig": {
