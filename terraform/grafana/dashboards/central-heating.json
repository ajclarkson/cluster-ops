        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Setpoint" }, "properties": [{ "id": "custom.lineStyle", "value": { "dash": [10, 6], "fill": "dash" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      }
    },
    {
      "id": 12,
      "title": "Hallway Downstairs — temp vs setpoint",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "influxdb", "uid": "ff0wxi3sjn2m8a" },
      "targets": [
        { "refId": "A", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"current_temperature\" AS \"Actual\" FROM \"climate.hallway_downstairs_trv\" WHERE $timeFilter" },
        { "refId": "B", "rawQuery": true, "resultFormat": "time_series", "query": "SELECT \"temperature\" AS \"Setpoint\" FROM \"climate.hallway_downstairs_trv\" WHERE $timeFilter" }
